# ======================================================================================
#  Подключение сторонних (third-party) библиотек
# ======================================================================================
#
#  Есть три основных способа добавить внешнюю библиотеку в CMake-проект:
#
#  1. find_package(Foo)      — найти библиотеку, уже установленную в системе
#                              (через apt / brew / vcpkg / conan).
#                              + быстро: ничего не качается и не собирается;
#                              − версия зависит от машины, у всех студентов разная.
#
#  2. FetchContent           — CMake сам клонирует репозиторий на этапе configure
#                              и подключает его как подпроект (add_subdirectory).
#                              + полная воспроизводимость: версия зафиксирована в GIT_TAG;
#                              + ничего не нужно устанавливать руками;
#                              − нужен интернет при первой конфигурации, первая сборка долгая.
#
#  3. git submodule          — исходники библиотеки лежат внутри нашего репозитория
#                              как ссылка на конкретный коммит, рядом в папке external/.
#                              + работает без интернета после клонирования;
#                              − требует `git clone --recursive` и ручного обновления;
#                                студенты регулярно забывают про --recursive.
#
#  В этом проекте используется FetchContent — он не требует от студента
#  ни установки пакетов, ни специальных флагов git.
#
#  Для nlohmann/json дополнительно показан гибридный паттерн
#  «сначала find_package, если не нашли — FetchContent».
# ======================================================================================

include(FetchContent)

# --------------------------------------------------------------------------------------
# nlohmann/json — HEADER-ONLY библиотека
# --------------------------------------------------------------------------------------
# Header-only значит, что вся реализация лежит в .hpp файлах: компилировать нечего,
# .a/.so файла не существует. "Слинковаться" с такой библиотекой = получить путь
# к её заголовкам и нужные флаги компиляции. В CMake это выражается через
# INTERFACE-цель (add_library(... INTERFACE)) — цель без собственных исходников,
# которая только передаёт требования тем, кто с ней линкуется.
# --------------------------------------------------------------------------------------

# QUIET — не ругаться, если пакета в системе нет; мы сами обработаем этот случай.
find_package(nlohmann_json 3.11 QUIET)

if(nlohmann_json_FOUND)
    message(STATUS "deps: nlohmann_json найден в системе (${nlohmann_json_DIR})")
else()
    message(STATUS "deps: nlohmann_json не найден в системе — скачиваем через FetchContent")

    # JSON_BuildTests — опция самого nlohmann/json. Отключаем, чтобы не собирать
    # тысячи тестов библиотеки вместе с нашим проектом.
    # CACHE ... FORCE нужен потому, что внутри подпроекта это объявлено через option(),
    # а option() читает значение из кэша CMake.
    set(JSON_BuildTests OFF CACHE BOOL "" FORCE)

    FetchContent_Declare(nlohmann_json
        GIT_REPOSITORY https://github.com/nlohmann/json.git
        GIT_TAG        v3.12.0   # всегда фиксируем тег, а не ветку: иначе сборка невоспроизводима
        GIT_SHALLOW    TRUE      # качаем один коммит вместо всей истории
    )

    # MakeAvailable = скачать (если ещё не скачано) + add_subdirectory.
    # После этого цель nlohmann_json::nlohmann_json доступна как своя.
    FetchContent_MakeAvailable(nlohmann_json)
endif()

# --------------------------------------------------------------------------------------
# OpenXLSX — КОМПИЛИРУЕМАЯ библиотека
# --------------------------------------------------------------------------------------
# В отличие от json, здесь есть .cpp файлы, которые нужно скомпилировать
# в статическую библиотеку libOpenXLSX.a и слинковать с нашим кодом.
# Первая сборка проекта поэтому заметно дольше: собирается не только наш код,
# но и сама библиотека вместе с её зависимостями (miniz — распаковка zip,
# pugixml — разбор XML; xlsx-файл это zip-архив с XML внутри).
# --------------------------------------------------------------------------------------

# Отключаем всё, что нам не нужно: документацию (требует Doxygen), примеры, тесты.
set(OPENXLSX_CREATE_DOCS      OFF CACHE BOOL "" FORCE)
set(OPENXLSX_BUILD_SAMPLES    OFF CACHE BOOL "" FORCE)
set(OPENXLSX_BUILD_TESTS      OFF CACHE BOOL "" FORCE)
set(OPENXLSX_BUILD_BENCHMARKS OFF CACHE BOOL "" FORCE)

# Пример ТРАНЗИТИВНОЙ зависимости на уровне сборки: у OpenXLSX есть свои
# зависимости (miniz, pugixml). Этот флаг разрешает ей скачать их самостоятельно,
# иначе CMake потребует, чтобы они были предустановлены в системе.
set(FETCH_DEPS_AUTO           ON  CACHE BOOL "" FORCE)

FetchContent_Declare(OpenXLSX
    GIT_REPOSITORY https://github.com/troldal/OpenXLSX.git
    GIT_TAG        v0.5.1
    GIT_SHALLOW    TRUE
)
FetchContent_MakeAvailable(OpenXLSX)
